generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  createdAt DateTime @default(now())
  image     String?
  username  String?
}

model Events {
  id        String    @id @default(uuid())
  image     String?
  name      String
  startDate DateTime  @default(now())
  endDate   DateTime?
  parent    String?
  createdAt DateTime  @default(now())
}
